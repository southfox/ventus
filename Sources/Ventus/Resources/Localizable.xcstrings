    "Switch between Forecast Dashboard, Forecast Grid, Grid and Dashboard, or Overview from the menu or Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle im Menü oder in den Einstellungen zwischen Vorhersage-Dashboard, Vorhersagetabelle, Tabelle und Dashboard oder Übersicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia entre Panel de pronóstico, Grilla de pronóstico, Grilla y panel o Resumen desde el menú o los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculez entre Tableau de bord des prévisions, Grille de prévision, Grille et tableau de bord ou Aperçu depuis le menu ou les réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne entre Painel de previsão, Grade de previsão, Grade e painel ou Visão geral pelo menu ou nos Ajustes."
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System"
          }
        },
        "es" : {
          "stringUnit" : {
