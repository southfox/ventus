          }
        }
      }
    },
    "These interface previews show how the same forecast workflow adapts to each Ventus app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Oberflächenvorschauen zeigen, wie sich derselbe Vorhersageablauf an jede Ventus-App anpasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas vistas previas de interfaz muestran cómo se adapta el mismo flujo de pronóstico a cada app de Ventus."
          }
        },
        "fr" : {
          "stringUnit" : {
