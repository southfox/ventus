    "Scroll through hours, tap a column to select it, and use the comparison control to inspect individual or all model sources." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättere durch die Stunden, tippe auf eine Spalte, um sie auszuwählen, und verwende die Vergleichssteuerung, um einzelne oder alle Modellquellen zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate por las horas, toca una columna para seleccionarla y usa el control de comparación para inspeccionar fuentes individuales o todas las fuentes de modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler les heures, touchez une colonne pour la sélectionner, et utilisez le contrôle de comparaison pour examiner une ou toutes les sources de modèles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorra as horas, toque em uma coluna para selecioná-la e use o controle de comparação para inspecionar fontes de modelo individuais ou todas."
          }
        }
      }
    },
    "Sea & Swell" : {
