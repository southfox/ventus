    "Thank you to Adriana Mandjarova for sharing these free Lottie weather animations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke an Adriana Mandjarova für die kostenlose Bereitstellung dieser Lottie-Wetteranimationen."
