    "Choose System, Light, or Dark in Settings, plus a color theme that changes the palette and font design independently of light or dark mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle System, Hell oder Dunkel in den Einstellungen, sowie ein Farbthema, das Palette und Schriftdesign unabhängig vom Hell-/Dunkelmodus ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Sistema, Claro u Oscuro en Ajustes, además de un tema de color que cambia la paleta y el diseño de fuente independientemente del modo claro u oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Système, Clair ou Sombre dans les Réglages, ainsi qu'un thème de couleur qui modifie la palette et la police indépendamment du mode clair ou sombre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Sistema, Claro ou Escuro em Ajustes, além de um tema de cor que muda a paleta e o design da fonte independentemente do modo claro ou escuro."
          }
        }
      }
    },
