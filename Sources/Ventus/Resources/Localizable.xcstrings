    "Winds at that strength can make it feel noticeably colder than the air temperature alone suggests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wind dieser Stärke kann sich deutlich kälter anfühlen, als es die Lufttemperatur allein vermuten lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viento de esa intensidad puede hacer que se sienta notablemente más frío de lo que sugiere solo la temperatura del aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vent de cette intensité peut donner une sensation nettement plus froide que ne le suggère la seule température de l'air."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventos dessa intensidade podem fazer a sensação térmica ficar bem mais fria do que sugere apenas a temperatura do ar."
          }
        }
      }
    }
  },
