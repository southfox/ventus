    "Wet surfaces from rain, combined with a low of %@ around %@, can refreeze into ice on exposed paths and roads overnight." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasse Oberflächen durch Regen können zusammen mit einem Tiefstwert von %@ gegen %@ über Nacht auf ungeschützten Wegen und Straßen zu Eis gefrieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las superficies mojadas por la lluvia, junto con una mínima de %@ hacia %@, pueden volver a congelarse formando hielo durante la noche en caminos y carreteras expuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les surfaces mouillées par la pluie, combinées à un minimum de %@ vers %@, peuvent regeler en verglas pendant la nuit sur les chemins et routes exposés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superfícies molhadas pela chuva, combinadas com uma mínima de %@ por volta de %@, podem voltar a congelar formando gelo durante a noite em caminhos e estradas expostos."
          }
        }
      }
    },
    "When multiple sources are selected, Ventus presents a Ventus Mix: one continuous forecast assembled from the selected model data available for each hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn mehrere Quellen ausgewählt sind, zeigt Ventus einen Ventus Mix: eine durchgehende Vorhersage, die aus den Daten der ausgewählten Modelle für jede Stunde zusammengestellt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se seleccionan varias fuentes, Ventus presenta un Ventus Mix: un pronóstico continuo compuesto por los datos de los modelos seleccionados disponibles para cada hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque plusieurs sources sont sélectionnées, Ventus présente un Ventus Mix : une prévision continue composée des données des modèles sélectionnés disponibles pour chaque heure."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando várias fontes são selecionadas, o Ventus apresenta um Ventus Mix: uma previsão contínua montada a partir dos dados dos modelos selecionados disponíveis para cada hora."
          }
        }
      }
    },
