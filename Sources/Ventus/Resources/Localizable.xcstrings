    "Themes change colors and font design without changing text sizes. System Default follows the current device appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Themen ändern Farben und Schriftdesign, ohne die Textgröße zu ändern. \"Systemstandard\" folgt dem aktuellen Erscheinungsbild des Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas cambian los colores y el diseño de tipografía sin cambiar el tamaño del texto. \"Predeterminado del sistema\" sigue la apariencia actual del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les thèmes changent les couleurs et la typographie sans modifier la taille du texte. « Système par défaut » suit l'apparence actuelle de l'appareil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temas mudam as cores e o design da fonte sem alterar o tamanho do texto. \"Padrão do sistema\" segue a aparência atual do dispositivo."
          }
        }
      }
    },
    "Thermometer icon shape and color" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Form und Farbe des Thermometersymbols"
