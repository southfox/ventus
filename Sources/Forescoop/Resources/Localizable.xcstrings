    "Get notified about heavy snow, extreme cold, or extreme heat forecast near your selected location, or set up your own push alerts for specific spots, models, and conditions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dich über starken Schneefall, extreme Kälte oder extreme Hitze in der Nähe deines ausgewählten Standorts benachrichtigen, oder richte eigene Push-Warnungen für bestimmte Spots, Modelle und Bedingungen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibí notificaciones sobre nevadas intensas, frío extremo o calor extremo pronosticado cerca de tu ubicación seleccionada, o configurá tus propias alertas push para spots, modelos y condiciones específicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification en cas de fortes chutes de neige, de froid extrême ou de chaleur extrême prévus près de votre emplacement sélectionné, ou configurez vos propres alertes push pour des spots, modèles et conditions spécifiques."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba notificações sobre neve intensa, frio extremo ou calor extremo previstos perto da sua localização selecionada, ou configure seus próprios alertas push para spots, modelos e condições específicos."
          }
        }
      }
